{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefundCompleted",
  "description": "Routing key: refund.completed. Published by payment when a charge became REFUNDED; consumed by notification. userId, amountCents and refundedAt are optional extras.",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "RefundCompleted"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "required": [
            "subscriptionId",
            "chargeId"
          ],
          "additionalProperties": false,
          "properties": {
            "subscriptionId": {
              "$ref": "../common.schema.json#/$defs/uuid"
            },
            "chargeId": {
              "$ref": "../common.schema.json#/$defs/uuid"
            },
            "userId": {
              "$ref": "../common.schema.json#/$defs/uuid"
            },
            "amountCents": {
              "type": "integer",
              "minimum": 1
            },
            "refundedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}
