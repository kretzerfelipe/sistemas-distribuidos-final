@host = http://localhost:8080
@adminEmail = admin@futhub.local
@adminPassword = admin12345
@userEmail = admin@futhub.local
@userPassword = admin12345
@teamEmail = team@example.com
@teamPassword = s3cret-pass
@userToken =

### Health check
GET {{host}}/health

### Register a regular user
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "Ana Silva",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Login as the regular user
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Login as the admin
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Current user (needs the userToken)
GET {{host}}/auth/me
Authorization: Bearer {{userToken}}

### Register a team user
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "Furb FC Owner",
  "email": "{{teamEmail}}",
  "password": "{{teamPassword}}",
  "accountType": "TEAM"
}
