@host = http://localhost:8080
@adminEmail = admin@futhub.local
@adminPassword = admin12345
@userEmail = admin@futhub.local
@userPassword = admin12345
@teamEmail = team@example.com
@teamPassword = s3cret-pass
@userToken =

### Register a regular user
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "Carol Souza",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Login as the regular user (saves userToken and userId)
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Login as the admin (saves adminToken and adminId)
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### List all users as admin
GET {{host}}/users
Authorization: Bearer {{adminToken}}

### Get my own user
GET {{host}}/users/{{userId}}
Authorization: Bearer {{userToken}}

### Get any user as admin
GET {{host}}/users/{{userId}}
Authorization: Bearer {{adminToken}}

### Change the role of a user as admin (USER, TEAM or ADMIN)
PATCH {{host}}/users/{{userId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "TEAM"
}
