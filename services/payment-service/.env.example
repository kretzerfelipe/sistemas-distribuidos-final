# Variables to run the main service OUTSIDE Docker (e.g. from GoLand).
# Everything points to localhost, on the ports published by docker-compose.
# Inside Docker, these variables are defined by docker-compose.yml.

HTTP_PORT=8080

# Main service database (RDS Postgres) and cache (ElastiCache Redis)
DATABASE_URL=postgres://futhub:futhub123@localhost:15432/db_main
REDIS_URL=redis://localhost:16379

# RabbitMQ and the outbox that publishes the match events
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=futhub.events
OUTBOX_POLL_INTERVAL_MS=500

# AWS (MiniStack)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=futhub-photos

# Authentication (JWT secret must have at least 32 characters; use a different one outside local development)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRATION_MINUTES=60
BCRYPT_COST=12
# First admin, created at startup if it does not exist yet (leave ADMIN_EMAIL empty to skip)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@futhub.local
ADMIN_PASSWORD=admin12345

# Subscription saga
PAYMENT_TIMEOUT_SECONDS=30
EXPIRATION_JOB_INTERVAL_SECONDS=5
SUBSCRIPTION_PRICE_CENTS=1990

# Notification service, when run OUTSIDE Docker (cd services/notification && go run ./cmd/api).
# These override HTTP_PORT and DATABASE_URL above, which belong to the main service.
NOTIFICATION_HTTP_PORT=8082
NOTIFICATION_DATABASE_URL=postgres://futhub:futhub123@localhost:15434/db_notification
CONSUMER_QUEUE=notification.q
RETRY_QUEUE=notification.retry
DEAD_LETTER_QUEUE=notification.dlq
MAX_RETRIES=3
PREFETCH=5
# Free users read a summary refreshed at this interval (use 20-30 to demo; 300 in production)
SNAPSHOT_INTERVAL_SECONDS=30
# Development only: comma separated user UUIDs treated as premium until the subscription saga exists in main
PREMIUM_USER_IDS=
ADMIN_IS_PREMIUM=true

# Used by docker-compose when creating the databases (optional; they have defaults)
DB_USER=futhub
DB_PASSWORD=futhub123

# Payment service (Java / Spring Boot), when run OUTSIDE Docker (cd services/payment && mvn spring-boot:run).
# The PAYMENT_* names win over the shared names above, so they do not clash with the main/notification values.
PAYMENT_HTTP_PORT=8083
PAYMENT_DATABASE_URL=postgres://futhub:futhub123@localhost:15433/db_payment
PAYMENT_CONSUMER_QUEUE=payment.q
PAYMENT_RETRY_QUEUE=payment.retry
PAYMENT_DEAD_LETTER_QUEUE=payment.dlq
# Simulated gateway (R5): latency, failure probability (0.0 to 1.0), timeout per call and attempts per charge
GATEWAY_LATENCY_MS=500
GATEWAY_LATENCY_JITTER_MS=300
GATEWAY_FAILURE_RATE=0.2
GATEWAY_TIMEOUT_MS=5000
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_RETRY_BACKOFF_MS=200
